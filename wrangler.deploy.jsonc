{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formpoesie-masterbrain",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "formpoesie-masterbrain",
      "database_id": "683d114f-2961-4bd7-94d7-77aea5f1cca8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "formpoesie-masterbrain-files"
    }
  ],
  "observability": {
    "enabled": true
  }
}
